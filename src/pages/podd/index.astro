---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { poddAvsnitt, serieTitel, serieBeskrivning, aiNotis } from '../../data/podd';

function truncate(text: string, max: number) {
  if (text.length <= max) return text;
  return text.slice(0, max).replace(/\s+\S*$/, '') + '...';
}
---

<BaseLayout
  title={`Invånare berättar – ${serieTitel} | Hela Stenungsund`}
  description={serieBeskrivning}
  ogImage="/podd/bilder/01_odsmal-hanna.webp"
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-ocean to-ocean/90 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <p class="text-sm font-semibold text-white/60 uppercase tracking-wider mb-3">
        Podcastserie · 7 avsnitt
      </p>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl mb-4">{serieTitel}</h1>
      <p class="text-xl md:text-2xl text-white/90 mb-6">Invånare berättar</p>
      <p class="text-base md:text-lg text-white/80 leading-relaxed max-w-3xl">
        {serieBeskrivning}
      </p>
    </div>
  </section>

  <!-- AI-notis -->
  <section class="bg-white border-b border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <p class="text-sm text-muted">
        <span class="font-semibold">Obs:</span> {aiNotis}
      </p>
    </div>
  </section>

  <!-- Avsnittsgrid -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {poddAvsnitt.map((a) => (
        <a
          href={`/podd/${a.slug}`}
          class="group bg-white rounded-xl border border-border overflow-hidden hover:shadow-lg hover:border-ocean/30 transition-all"
        >
          <div class="aspect-square overflow-hidden">
            <img
              src={a.bild}
              alt={`Porträtt av ${a.person}`}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-5">
            <p class="text-xs font-semibold text-ocean uppercase tracking-wider mb-1">
              Avsnitt {a.nr} · {a.ort} · {a.langdMin} min
            </p>
            <h2 class="font-heading text-xl text-charcoal mb-1 group-hover:text-ocean transition-colors">
              {a.titel}
            </h2>
            <p class="text-sm font-medium text-charcoal/70 mb-2">{a.person} — {a.roll}</p>
            <p class="text-sm text-muted leading-relaxed">{truncate(a.beskrivning, 140)}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
